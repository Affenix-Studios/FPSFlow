# Done to increase the memory available to the Gradle daemon.
org.gradle.jvmargs=-Xmx2G -XX:MaxMetaspaceSize=512m

# Fabric Properties
# VERSION-INDEPENDENT: To upgrade to a newer Minecraft version, change:
# 1. minecraft_version (e.g. 1.22.0)
# 2. loader_version (match the new version)
# 3. fabric_version (match the new version)
# No Yarn/Mojang mappings version to search for — Loom resolves them from Mojang's official repo.
minecraft_version=1.21.11
mappings_version=2024.11.18
loader_version=0.19.3

# Mod Properties
mod_version=1.8
modmenu_version=17.0.0
maven_group=dev.fpsflow
archives_base_name=fpsflow

# Java version to target (21, 25, or any future LTS)
java_version=25

# Dependencies
fabric_version=0.141.4+1.21.11