{
  "schemaVersion": 1,
  "id": "fpsflow",
  "version": "${version}",
  "name": "FPSFlow",
  "description": "Real FPS improvements - no placebo, no bloat. Minecraft 26.2 compatibility build.",
  "authors": [
    {
      "name": "FPSFlow Contributors"
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/fpsflow",
    "sources": "https://github.com/McAffe13/FPSFlow",
    "issues": "https://github.com/McAffe13/FPSFlow/issues"
  },
  "license": "MPL-2.0",
  "icon": "assets/fpsflow/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.fpsflow.FPSFlow"
    ],
    "client": [
      "dev.fpsflow.FPSFlowClient"
    ],
    "modmenu": [
      "dev.fpsflow.modmenu.FPSFlowModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "${fabric_dep}",
    "minecraft": "${minecraft_dep}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  }
}
